{
  "name": "tree-sitter-goml",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the GoML programming language",
  "private": true,
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "tree-sitter build",
    "test": "tree-sitter test --config-path tree-sitter-config.json && node --test test/integration/*.test.cjs",
    "test:corpus": "tree-sitter test --config-path tree-sitter-config.json",
    "test:integration": "node --test test/integration/*.test.cjs",
    "test:sources": "node scripts/check-sources.cjs",
    "check:scanner": "cc -std=c11 -Wall -Wextra -Werror -Isrc -fsyntax-only src/scanner.c"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.9"
  }
}
