//! A small GoML program demonstrating the syntax tree and editor queries.
package main;

enum Greeting {
    Named(string),
    Anonymous,
}

impl Greeting {
    fn render(self) -> string {
        match self {
            Named(name) => f"Hello, {name}!",
            Anonymous => "Hello, world!",
        }
    }
}

fn first[T](values: Vec[T]) -> Option[T] {
    if values.len() > 0 {
        Some(values[0])
    } else {
        None
    }
}

fn main() -> () {
    let greeting = Greeting::Named("GoML");
    println(greeting.render());
    let path = r#"a\path\with\"quotes""#;
    println(path);
    if let Some(value) = first::[isize]([1, 2, 3]) && value > 0 {
        println(value)
    }
}
